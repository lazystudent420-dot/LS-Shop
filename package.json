{
  "name": "grove-grocery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-grove --only firestore 'node --test tests/rules.integration.mjs'",
    "emulators": "firebase emulators:start --project demo-grove",
    "deploy": "npm run build && npm --prefix functions run build && firebase deploy",
    "test:transactions": "firebase emulators:exec --project demo-grove --only firestore \"node --test tests/transactions.integration.mjs\"",
    "test:functions": "firebase emulators:exec --project demo-grove --only auth,firestore,functions \"node --test tests/functions.integration.mjs\"",
    "test:ui": "node --test tests/ui.integration.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
